# Порт API
PORT=8787
HOST=0.0.0.0

# Где лежит база (по умолчанию server/data)
DATA_DIR=./data

# Секрет для хеширования кодов и токенов — обязательно сменить
AUTH_SECRET=change-me-please

# Токен админки — обязательно сменить
ADMIN_TOKEN=change-me-please

# Почта: console | resend
MAIL_MODE=console
RESEND_API_KEY=
MAIL_FROM=Помогатор <login@pomogator.ru>

# Доступы
MAX_DEVICES=2
SESSION_DAYS=30
TRIAL_SECONDS=1200
