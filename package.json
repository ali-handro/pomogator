{
  "name": "pomogator",
  "productName": "Pomogator",
  "version": "0.32.1",
  "description": "Помогатор",
  "main": "src/main.js",
  "author": "Alihandro",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --publish never",
    "pack": "electron-builder --dir",
    "test": "node --test tests/stt-text.test.js tests/crop.test.js tests/version.test.js tests/prompt.test.js",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.pomogator.app",
    "productName": "Pomogator",
    "compression": "maximum",
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/uiohook-napi/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/{fs-extra,js-yaml,argparse,lazy-val,lodash.escaperegexp,lodash.isequal,semver,tiny-typed-emitter,debug,ms,sax,graceful-fs,jsonfile,universalify}/**/*",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "ali-handro",
        "repo": "pomogator"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "Pomogator-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Помогатор",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Pomogator-${version}.exe",
      "unpackDirName": "Pomogator"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5"
  }
}
