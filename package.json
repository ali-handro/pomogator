{
  "name": "pomogator",
  "productName": "Pomogator",
  "version": "0.26.0",
  "description": "Помогатор",
  "main": "src/main.js",
  "author": "Alihandro",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.pomogator.app",
    "productName": "Pomogator",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/uiohook-napi/**/*"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "Pomogator-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Помогатор",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Pomogator-${version}.exe",
      "unpackDirName": "Pomogator"
    }
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
